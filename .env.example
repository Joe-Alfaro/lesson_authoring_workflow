# Copy to .env and fill in. Never commit .env.
# Leave DATABASE_URL empty locally to use the docker compose database.
DATABASE_URL=
# Host port for the compose Postgres (default 5432).
POSTGRES_PORT=
# Auth.js session secret: openssl rand -base64 32. Web and collab must share it (collab tokens).
AUTH_SECRET=
# Password for seeded demo accounts. Required in production; local default is in the README.
SEED_PASSWORD=
# Anthropic key for generation (worker) and AI assist (web). Without it, both are disabled.
ANTHROPIC_API_KEY=
# Optional: send model calls to another Anthropic-compatible URL instead, e.g. the stand-in
# from `npm run load:fake-model` (http://localhost:3764) for no-cost runs. Empty for the real API.
ANTHROPIC_BASE_URL=
# Each process reads PORT when deployed. Locally, leave PORT empty: web 3000, worker 4100, collab 4200.
PORT=
# Optional: an existing empty database for the integration tests instead of a Testcontainers one.
TEST_DATABASE_URL=
# Optional: an "anyone with the link" Google Sheet holding the scrubbed sample outline, for the
# live R1 import test (src/import/sheet_link.live.test.ts). Skipped when empty.
IMPORT_TEST_SHEET_URL=
# Generation (M2). Defaults: Haiku-class model, concurrency 4, 2 attempts, $5 spend cap per run.
GENERATION_MODEL=
GENERATION_CONCURRENCY=
GENERATION_MAX_ATTEMPTS=
GENERATION_SPEND_CAP_USD=
# Model thinking effort for generation: low, medium (default) or high.
GENERATION_EFFORT=
# Crash recovery: seconds without a heartbeat before a dead worker's lesson is retried (>= 10, default 60).
GENERATION_HEARTBEAT_SECONDS=
# Global LLM budget across all runs in USD (default 20).
SPEND_CAP_USD=
# AI assist (M4) in the web app: model for suggestions, regenerate-section and alignment (default
# the Haiku-class model). Uses ANTHROPIC_API_KEY; spend counts in SPEND_CAP_USD.
ASSIST_MODEL=
# Postgres pool size per process (default 10).
DB_POOL_MAX=
# pg-boss's own pool in the web app and the worker (default 2).
PGBOSS_POOL_MAX=
# WebSocket URL of the collab server as the browser sees it (default ws://localhost:4200).
# Read by the web app at request time, so one image works for every environment.
COLLAB_URL=
