# Copy to .env and fill in. Never commit .env.
# Leave DATABASE_URL empty locally to use the docker compose database.
DATABASE_URL=
# Host port for the compose Postgres (default 5432).
POSTGRES_PORT=
# Auth.js session secret: openssl rand -base64 32
AUTH_SECRET=
# Password for seeded demo accounts. Required in production; local default is in the README.
SEED_PASSWORD=
# Used from M2 on (generation). Not needed for M0.
ANTHROPIC_API_KEY=
# Each process reads PORT when deployed. Locally, leave PORT unset: web 3000, worker 4100, collab 4200.
