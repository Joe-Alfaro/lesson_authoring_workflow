{
  "name": "lesson-authoring-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker,collab -c blue,magenta,green \"npm:dev:web\" \"npm:dev:worker\" \"npm:dev:collab\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:collab": "tsx watch src/collab/main.ts",
    "build": "next build",
    "start:web": "next start",
    "start:worker": "tsx src/worker/main.ts",
    "start:collab": "tsx src/collab/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate_cli.ts",
    "db:seed": "tsx src/db/seed/seed_cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "scrub": "tsx scripts/scrub_check.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run scrub"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.7.1",
    "@hocuspocus/provider": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
